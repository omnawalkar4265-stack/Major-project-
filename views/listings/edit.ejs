<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>WanderLust</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

  <div class="container mt-4">
    <h3 class="mb-4">Edit your Listing</h3>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">

      <div class="mb-3">
        <label class="form-label">Title</label>
        <input name="listing[title]" value="<%= listing.title %>" placeholder="enter title" type="text" class="form-control" required />
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="listing[description]" placeholder="enter description" class="form-control" required><%= listing.description %></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Upload New Image</label>
        <input name="listing[image]" type="file" class="form-control" accept="image/*" />
        <% if (listing.image && listing.image.url) { %>
          <img src="<%= listing.image.url %>" class="img-fluid mt-2 rounded" style="max-height: 150px;" alt="current image">
        <% } %>
      </div>

      <!-- Price + Country (Same Row) -->
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Price</label>
          <input name="listing[price]" value="<%= listing.price %>" placeholder="enter price" type="number" class="form-control" required />
        </div>

        <div class="col-md-6 mb-3">
          <label class="form-label">Country</label>
          <input name="listing[country]" value="<%= listing.country %>" placeholder="enter country" type="text" class="form-control" required />
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Location</label>
        <input name="listing[location]" value="<%= listing.location %>" placeholder="enter location" type="text" class="form-control" required />
      </div>

      <button class="btn btn-danger">Edit</button>

    </form>
  </div>

</body>
</html>